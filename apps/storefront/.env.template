# Copy to .env.local to override defaults. Every value is optional: the
# storefront runs entirely on local mock data (src/lib/mock).

# Default country code used when a URL has none.
NEXT_PUBLIC_DEFAULT_REGION=in

# Public base URL of this storefront (used for absolute links, OG tags, etc.).
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Store address shown on the /contact page map (comma-separated; geocoded by
# the keyless Google Maps embed). Each comma-separated part renders on its own line.
NEXT_PUBLIC_STORE_ADDRESS="100 Feet Road, Indiranagar, Bengaluru, Karnataka 560038, India"
